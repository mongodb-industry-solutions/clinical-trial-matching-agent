#
# Clinical Trial Matching Agent backend environment
# Copy this file to backend/.env for local development.
#

APP_NAME=clinical-trial-matching-agent
ORIGINS=http://localhost:3014

# Clinical-trial-owned MongoDB runtime
CLINICAL_TRIALS_MONGODB_URI=
CLINICAL_TRIALS_DATABASE_NAME=

# Leafy Hospital patient context runtime
# Leave these blank to reuse the clinical-trials Mongo runtime.
LEAFY_HOSPITAL_MONGODB_URI=
LEAFY_HOSPITAL_DATABASE_NAME=

# Trial collections
PHARMA_TRIALS_COLLECTION=pharma_clinical_trials
CLINICAL_TRIALS_TRIALS_COLLECTION=clinical_trial_trials
CLINICAL_TRIALS_VERSIONS_COLLECTION=clinical_trial_versions
CLINICAL_TRIALS_CRITERIA_COLLECTION=clinical_trial_criteria
PHARMA_PATIENT_PROFILES_COLLECTION=pharma_patient_profiles
PHARMA_PATIENT_FACTS_COLLECTION=pharma_patient_facts
PHARMA_EVALUATION_RUNS_COLLECTION=pharma_evaluation_runs
PHARMA_IMPROVEMENT_RUNS_COLLECTION=pharma_improvement_runs
PHARMA_ONCOLOGY_COHORT_COLLECTION=
PHARMA_FEATURE_EDGES_COLLECTION=

# Patient linkage and Synthea/FHIR mirrors
LEAFY_SYNTHEA_LINKS_COLLECTION=leafy_synthea_links
SYNTHEA_FHIR_DB=hc_fhir_synthea_r4_sep2019_canonical
SYNTHEA_RESOURCES_COLLECTION=fhir_resources

# ClinicalTrials.gov ingestion
CLINICALTRIALS_API_BASE=https://clinicaltrials.gov/api/v2
CLINICALTRIALS_DEFAULT_CONDITION=breast cancer
CLINICALTRIALS_SYNC_DAYS_BACK=35
CLINICALTRIALS_TIMEOUT_SEC=30

# Trial matching behavior
PHARMA_STRICT_CANONICAL_MODE=true
CLINICAL_TRIALS_SERVICE_SYNC_ON_STARTUP=false
CLINICAL_TRIALS_SERVICE_BOOTSTRAP_LIMIT=80
TRIAL_MATCHING_DATASET_MIN_PATIENTS=25

# Optional ranking / embedding support
VOYAGE_API_KEY=
VOYAGE_API_BASE_URL=https://ai.mongodb.com/v1
VOYAGE_EMBEDDING_MODEL=voyage-3.5
VOYAGE_RERANK_MODEL=rerank-2-lite

# Deployed Bedrock settings
CHATCOMPLETIONS_MODEL_ID=
EMBEDDINGS_MODEL_ID=
AGENTIC_BEDROCK_MODEL=
BEDROCK_DEFAULT_MODEL=

# Legacy single-runtime aliases remain supported for backward compatibility.
MONGODB_URI=
DATABASE_NAME=

# Optional Kanopy per-environment secret promotion overrides.
# If omitted, scripts/promote-kanopy-app-secrets.sh falls back to the base values above.
STAGING_CLINICAL_TRIALS_MONGODB_URI=
STAGING_CLINICAL_TRIALS_DATABASE_NAME=
STAGING_LEAFY_HOSPITAL_MONGODB_URI=
STAGING_LEAFY_HOSPITAL_DATABASE_NAME=
STAGING_VOYAGE_API_KEY=
STAGING_CHATCOMPLETIONS_MODEL_ID=
STAGING_EMBEDDINGS_MODEL_ID=
PROT_CLINICAL_TRIALS_MONGODB_URI=
PROT_CLINICAL_TRIALS_DATABASE_NAME=
PROT_LEAFY_HOSPITAL_MONGODB_URI=
PROT_LEAFY_HOSPITAL_DATABASE_NAME=
PROT_VOYAGE_API_KEY=
PROT_CHATCOMPLETIONS_MODEL_ID=
PROT_EMBEDDINGS_MODEL_ID=
