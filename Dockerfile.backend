FROM python:3.13-slim

WORKDIR /
ENV PORT=8000

# uv installation
RUN pip install uv

# Copy project files
COPY /backend/pyproject.toml ./

# Install dependencies with uv
RUN uv sync --no-dev

# Copy the rest of the backend code
COPY ./backend/ .

# The backend runs as a Kanopy sidecar on 8000 by default, but can be
# promoted to a standalone pod by setting PORT=8080 at runtime.
EXPOSE 8000 8080

CMD ["sh", "-c", "uv run uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]
