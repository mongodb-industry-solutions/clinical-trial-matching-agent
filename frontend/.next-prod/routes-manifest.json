{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/backend/[...path]",
      "regex": "^/api/backend/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/backend/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/api/trial-geo/[nctId]",
      "regex": "^/api/trial\\-geo/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPnctId": "nxtPnctId"
      },
      "namedRegex": "^/api/trial\\-geo/(?<nxtPnctId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/[...path]",
      "regex": "^/api/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/pharmaNavigator/[[...slug]]",
      "regex": "^/pharmaNavigator(?:/(.+?))?(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/pharmaNavigator(?:/(?<nxtPslug>.+?))?(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/discovery",
      "regex": "^/discovery(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/discovery(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/governance",
      "regex": "^/governance(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/governance(?:/)?$"
    },
    {
      "page": "/literature",
      "regex": "^/literature(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/literature(?:/)?$"
    },
    {
      "page": "/match",
      "regex": "^/match(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/match(?:/)?$"
    },
    {
      "page": "/patients",
      "regex": "^/patients(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/patients(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}